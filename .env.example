# --- required in production ---
SESSION_SECRET=change-me-to-32-plus-random-characters
ENCRYPTION_KEY=change-me-to-32-plus-random-characters   # encrypts secret variables + TOTP seeds at rest. Losing it = losing secrets.
POSTGRES_PASSWORD=quiver
BASE_URL=http://localhost:4000            # public URL users open (used for OIDC/OAuth2 callbacks, invite links)

# --- access ---
ALLOW_SIGNUP=false                        # false = invite-only after the first admin is created
TRUST_PROXY=false                         # true when behind nginx/traefik/cloudflare

# --- outbound request policy (SSRF guard) ---
ALLOW_PRIVATE_TARGETS=true                # RFC1918 targets allowed (internal APIs). Link-local/metadata always blocked.
ALLOW_LOOPBACK_TARGETS=false              # 127.0.0.1 / localhost targets (from the server's point of view)
BLOCKED_HOSTS=                            # comma-separated, supports *.example.com

# --- optional integrations ---
SMTP_URL=                                 # smtp://user:pass@host:587  (invites, monitor alerts)
SMTP_FROM=quiver@localhost
OIDC_ISSUER=                              # e.g. https://auth.example.com (Authelia, Keycloak, Entra, Google...)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=SSO

# --- local development only (ignored when NODE_ENV=production) ---
DEV_AUTO_LOGIN=true                       # auto sign-in when opened on localhost; sign out to pause it
DEV_AUTO_LOGIN_EMAIL=                     # which account; defaults to the first admin
